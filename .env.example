# API_KEY_ENCRYPTION_SECRET: Random 32+ character server-only secret used to encrypt
# each teacher's personal Gemini API key (AES-256-GCM + HKDF) in Firestore.
# Set this in Settings > Secrets for production hardening.
API_KEY_ENCRYPTION_SECRET="CHANGE_ME_TO_A_STRONG_32_PLUS_CHAR_RANDOM_SECRET"

# GEMINI_API_KEY: Optional default AI Studio env var (NEVER shared across teachers;
# each approved teacher connects and uses their own personal Gemini API key).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
