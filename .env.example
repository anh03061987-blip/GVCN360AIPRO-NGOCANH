# API_KEY_ENCRYPTION_SECRET: REQUIRED in Production / Vercel!
# Random 32+ character server-only secret used to encrypt each teacher's personal
# Gemini API key (AES-256-GCM + HKDF-SHA256) in Firestore (users/{uid}/ai_key_vault/gemini).
# Set this in Vercel (Project Settings > Environment Variables) or AI Studio (Settings > Secrets).
API_KEY_ENCRYPTION_SECRET="CHANGE_ME_TO_A_STRONG_32_PLUS_CHAR_RANDOM_SECRET"

# ALLOWED_ORIGINS: Optional comma-separated list of custom frontend origins (e.g. https://gvcn.truonghoada.edu.vn)
# if you attach a custom domain on Vercel in addition to *.vercel.app.
ALLOWED_ORIGINS=""

# GEMINI_API_KEY: Optional default AI Studio env var (NEVER shared across teachers;
# each approved teacher connects and uses their own personal Gemini API key).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"
