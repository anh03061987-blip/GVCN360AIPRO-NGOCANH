          allow update: if isValidId(userId) && isValidId(workspaceId) && isValidId(errorId) && isApprovedTeacher(userId) &&
            isValidSubjectErrorLog(incoming(), userId) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'fixedAt', 'note', 'remedy', 'updatedAt']);
        }

        match /pedagogical_observations/{obsId} {
          allow get: if isValidId(userId) && isValidId(workspaceId) && isValidId(obsId) && isApprovedTeacher(userId);
          allow list: if isApprovedTeacher(userId);
          allow create: if isValidId(userId) && isValidId(workspaceId) && isValidId(obsId) && isApprovedTeacher(userId) &&
            parentUserExists(userId) &&
            isValidPedagogicalObservation(incoming(), userId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time;
          allow update: if isValidId(userId) && isValidId(workspaceId) && isValidId(obsId) && isApprovedTeacher(userId) &&
            isValidPedagogicalObservation(incoming(), userId) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().studentId == existing().studentId &&
            incoming().studentCode == existing().studentCode &&
            incoming().semester == existing().semester &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['moetCode', 'officialConduct', 'officialAcademic', 'verifiedStrengths', 'verifiedImprovements', 'verifiedAchievements', 'verifiedIncidentNote', 'incidentStatus', 'sourceLabel', 'confirmedByEmail', 'confirmedAtMs', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(workspaceId) && isValidId(obsId) && isApprovedTeacher(userId);
        }

        match /report_card_comments/{commentId} {
          allow get: if isValidId(userId) && isValidId(workspaceId) && isValidId(commentId) && isApprovedTeacher(userId);
          allow list: if isApprovedTeacher(userId);
          allow create: if isValidId(userId) && isValidId(workspaceId) && isValidId(commentId) && isApprovedTeacher(userId) &&
            parentUserExists(userId) &&
            isValidReportCardComment(incoming(), userId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time;
          allow update: if isValidId(userId) && isValidId(workspaceId) && isValidId(commentId) && isApprovedTeacher(userId) &&
            isValidReportCardComment(incoming(), userId) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().studentId == existing().studentId &&
            incoming().studentCode == existing().studentCode &&
            incoming().semester == existing().semester &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['moetCode', 'studentName', 'rosterOrder', 'schoolYear', 'lengthMode', 'schoolTemplate', 'maxChars', 'currentDraft', 'teacherEdited', 'status', 'approvedByEmail', 'approvedAtMs', 'versions', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(workspaceId) && isValidId(commentId) && isApprovedTeacher(userId);
        }

        match /parent_messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(workspaceId) && isValidId(messageId) && isApprovedTeacher(userId);
          allow list: if isApprovedTeacher(userId);
          allow create: if isValidId(userId) && isValidId(workspaceId) && isValidId(messageId) && isApprovedTeacher(userId) &&
            parentUserExists(userId) &&
            isValidParentMessage(incoming(), userId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time;
          allow update: if isValidId(userId) && isValidId(workspaceId) && isValidId(messageId) && isApprovedTeacher(userId) &&
            isValidParentMessage(incoming(), userId) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().studentId == existing().studentId &&
            incoming().studentCode == existing().studentCode &&
            incoming().semester == existing().semester &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['moetCode', 'studentName', 'recipientName', 'purpose', 'salutation', 'tone', 'incidentStatus', 'currentDraft', 'teacherEdited', 'status', 'approvedByEmail', 'approvedAtMs', 'versions', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(workspaceId) && isValidId(messageId) && isApprovedTeacher(userId);
        }
      }
    }
  }
}
