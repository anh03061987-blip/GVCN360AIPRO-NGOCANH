rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // GLOBAL HELPERS
    // ========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'anh03061987@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isApprovedTeacher(userId) {
      return isOwner(userId) && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/teacher_access_requests/$(userId)) &&
          get(/databases/$(database)/documents/teacher_access_requests/$(userId)).data.status == 'approved'
        )
      );
    }

    function hasValidOwnerAndTimestamps(data, userId) {
      return data.ownerUid is string &&
        data.ownerUid == userId &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isOfficerSignedIn() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/officer_memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/officer_memberships/$(request.auth.uid)).data.active == true;
    }

    function officerMembership() {
      return get(/databases/$(database)/documents/officer_memberships/$(request.auth.uid)).data;
    }

    function isWorkspaceOfficer(userId, workspaceId) {
      return isOfficerSignedIn() &&
        officerMembership().teacherUid == userId &&
        officerMembership().workspaceId == workspaceId;
    }

    function officerHasRole(userId, workspaceId, roleId) {
      return isWorkspaceOfficer(userId, workspaceId) &&
        roleId in officerMembership().roles;
    }

    function officerHasAnyTeamLeaderRole(userId, workspaceId) {
      return isWorkspaceOfficer(userId, workspaceId) &&
        officerMembership().assignedTeam >= 1 &&
        officerMembership().assignedTeam <= 4 &&
        (
          'to_truong_1' in officerMembership().roles ||
          'to_truong_2' in officerMembership().roles ||
          'to_truong_3' in officerMembership().roles ||
          'to_truong_4' in officerMembership().roles
        );
    }

    function officerCanCreateTicketType(userId, workspaceId, ticketType, roleId) {
      return officerHasRole(userId, workspaceId, roleId) && (
        (roleId == 'lop_truong' && (ticketType in ['diem_danh', 'ne_nep'])) ||
        ((roleId in ['to_truong_1', 'to_truong_2', 'to_truong_3', 'to_truong_4']) && (ticketType in ['diem_danh', 'ne_nep'])) ||
        (roleId == 'thu_quy' && ticketType == 'thu_chi') ||
        (roleId == 'bi_thu' && ticketType == 'chi_doan')
      );
    }

    // Connection check doc (read-only single doc get)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ========================================================================
    // ENTITY VALIDATION HELPERS (Anti-Update-Gap)
    // ========================================================================
    function isValidUserRoot(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTeacherAiKeyVault(data, userId) {
      return hasValidOwnerAndTimestamps(data, userId) &&
        data.keys().hasAll(['ownerUid', 'provider', 'alg', 'keyVersion', 'saltB64', 'ivB64', 'authTagB64', 'ciphertextB64', 'maskedHint', 'status', 'lastVerifiedAtMs', 'updatedAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'provider', 'alg', 'keyVersion', 'saltB64', 'ivB64', 'authTagB64', 'ciphertextB64', 'maskedHint', 'status', 'lastVerifiedAtMs', 'updatedAtMs', 'createdAt', 'updatedAt']) &&
        data.provider == 'gemini' &&
        data.alg == 'aes-256-gcm' &&
        data.keyVersion in ['v1-env', 'v1-fallback'] &&
        data.saltB64 is string && data.saltB64.size() >= 16 && data.saltB64.size() <= 128 &&
        data.ivB64 is string && data.ivB64.size() >= 12 && data.ivB64.size() <= 64 &&
        data.authTagB64 is string && data.authTagB64.size() >= 16 && data.authTagB64.size() <= 64 &&
        data.ciphertextB64 is string && data.ciphertextB64.size() >= 16 && data.ciphertextB64.size() <= 1024 &&
        data.maskedHint is string && data.maskedHint.size() > 0 && data.maskedHint.size() <= 40 &&
        data.status == 'connected' &&
        data.lastVerifiedAtMs is number &&
        data.updatedAtMs is number;
    }

    function isValidClassConfig(data, userId) {
      return data.keys().hasAll(['ownerUid', 'teacherName', 'subject', 'schoolName', 'className', 'schoolYear', 'fundBalance', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'teacherName', 'subject', 'schoolName', 'className', 'schoolYear', 'fundBalance', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 120 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() <= 200 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 50 &&
        data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 50 &&
        data.fundBalance is number;
    }

    function isValidSavedWorkspace(data, userId) {
      return data.keys().hasAll(['ownerUid', 'teacherName', 'subject', 'schoolName', 'className', 'schoolYear', 'updatedAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'teacherName', 'subject', 'schoolName', 'className', 'schoolYear', 'updatedAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 120 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() <= 200 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 50 &&
        data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 50 &&
        data.updatedAtMs is number;
    }

    function isValidStudent(data, userId) {
      return data.keys().hasAll(['ownerUid', 'code', 'fullName', 'gender', 'team', 'role', 'meritPoints', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'code', 'moetCode', 'fullName', 'gender', 'dob', 'team', 'rosterOrder', 'role', 'secondRole', 'roles', 'note', 'meritPoints', 'attendancePresent', 'attendanceAbsent', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9_\\-]+$') &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 40 && (data.moetCode == '' || data.moetCode.matches('^[A-Z0-9_\\-]+$')))) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
        data.gender in ['Nam', 'Nữ'] &&
        (!('dob' in data) || (data.dob is string && data.dob.size() <= 30)) &&
        data.team is number && data.team >= 0 && data.team <= 4 &&
        (!('rosterOrder' in data) || (data.rosterOrder is int && data.rosterOrder >= 1 && data.rosterOrder <= 500)) &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 40 &&
        (!('secondRole' in data) || (data.secondRole is string && data.secondRole.size() <= 40)) &&
        (!('roles' in data) || (data.roles is list && data.roles.size() <= 2 && data.roles.hasOnly(['lop_truong', 'to_truong_1', 'to_truong_2', 'to_truong_3', 'to_truong_4', 'thu_quy', 'bi_thu']))) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.meritPoints is number &&
        (!('attendancePresent' in data) || data.attendancePresent is number) &&
        (!('attendanceAbsent' in data) || data.attendanceAbsent is number);
    }

    function isValidStudentPii(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentCode', 'parentPhone', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentCode', 'parentName', 'parentPhone', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 && data.studentCode.matches('^[A-Z0-9_\\-]+$') &&
        (!('parentName' in data) || (data.parentName is string && data.parentName.size() <= 150)) &&
        data.parentPhone is string && data.parentPhone.size() <= 30;
    }

    function isValidTicket(data, userId) {
      return data.keys().hasAll(['ownerUid', 'type', 'typeLabel', 'studentName', 'category', 'date', 'description', 'submittedByRole', 'submittedByTitle', 'submittedByUid', 'status', 'version', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'type', 'typeLabel', 'studentId', 'studentName', 'category', 'emulationGroup', 'criterionId', 'criterionText', 'suggestedGrade', 'evidence', 'weekLabel', 'amount', 'date', 'description', 'submittedByRole', 'submittedByTitle', 'submittedByUid', 'status', 'version', 'approvalId', 'batchApprovalId', 'reviewedByTeacher', 'reviewedByUid', 'reviewedAtMs', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.type in ['diem_danh', 'ne_nep', 'thu_chi', 'chi_doan', 'hoc_tap'] &&
        data.typeLabel is string && data.typeLabel.size() <= 100 &&
        (!('studentId' in data) || data.studentId == null || (data.studentId is string && data.studentId.size() <= 64)) &&
        data.studentName is string && data.studentName.size() <= 200 &&
        data.category is string && data.category.size() <= 150 &&
        (!('emulationGroup' in data) || (data.emulationGroup is string && data.emulationGroup.size() <= 40)) &&
        (!('criterionId' in data) || (data.criterionId is string && data.criterionId.size() <= 40)) &&
        (!('criterionText' in data) || (data.criterionText is string && data.criterionText.size() <= 600)) &&
        (!('suggestedGrade' in data) || (data.suggestedGrade is string && data.suggestedGrade.size() <= 10)) &&
        (!('evidence' in data) || (data.evidence is string && data.evidence.size() <= 600)) &&
        (!('weekLabel' in data) || (data.weekLabel is string && data.weekLabel.size() <= 40)) &&
        (!('amount' in data) || data.amount is number) &&
        data.date is string && data.date.size() <= 30 &&
        data.description is string && data.description.size() <= 2000 &&
        data.submittedByRole is string && data.submittedByRole.size() <= 40 &&
        data.submittedByTitle is string && data.submittedByTitle.size() <= 100 &&
        data.submittedByUid is string && data.submittedByUid.size() > 0 && data.submittedByUid.size() <= 128 &&
        data.status in ['pending', 'needs_revision', 'approved', 'rejected'] &&
        data.version is number && data.version >= 1 &&
        (!('approvalId' in data) || data.approvalId == null || (data.approvalId is string && data.approvalId.size() <= 100)) &&
        (!('batchApprovalId' in data) || data.batchApprovalId == null || (data.batchApprovalId is string && data.batchApprovalId.size() <= 100)) &&
        (!('reviewedByTeacher' in data) || (data.reviewedByTeacher is string && data.reviewedByTeacher.size() <= 120)) &&
        (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128)) &&
        (!('reviewedAtMs' in data) || data.reviewedAtMs is number) &&
        data.createdAtMs is number;
    }

    function isValidAuditLog(data, userId) {
      return data.keys().hasAll(['ownerUid', 'action', 'ticketId', 'ticketType', 'summary', 'submittedBy', 'approvedBy', 'timestampMs', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'action', 'approvalId', 'batchApprovalId', 'ticketId', 'ticketType', 'summary', 'submittedBy', 'approvedBy', 'timestampMs', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.createdAt is timestamp &&
        data.action is string && data.action.size() <= 80 &&
        (!('approvalId' in data) || data.approvalId == null || (data.approvalId is string && data.approvalId.size() <= 100)) &&
        (!('batchApprovalId' in data) || data.batchApprovalId == null || (data.batchApprovalId is string && data.batchApprovalId.size() <= 100)) &&
        data.ticketId is string && data.ticketId.size() <= 128 &&
        data.ticketType is string && data.ticketType.size() <= 100 &&
        data.summary is string && data.summary.size() <= 1200 &&
        data.submittedBy is string && data.submittedBy.size() <= 120 &&
        data.approvedBy is string && data.approvedBy.size() <= 200 &&
        data.timestampMs is number;
    }

    function isValidAttendanceRecord(data, userId) {
      return data.keys().hasAll(['ownerUid', 'date', 'session', 'totalStudents', 'presentCount', 'excusedCount', 'unexcusedCount', 'lateCount', 'absentSummary', 'recordedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'date', 'session', 'totalStudents', 'presentCount', 'excusedCount', 'unexcusedCount', 'lateCount', 'absentSummary', 'recordedBy', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.date is string && data.date.size() <= 30 &&
        data.session in ['Sáng', 'Chiều'] &&
        data.totalStudents is number &&
        data.presentCount is number &&
        data.excusedCount is number &&
        data.unexcusedCount is number &&
        data.lateCount is number &&
        data.absentSummary is string && data.absentSummary.size() <= 2000 &&
        data.recordedBy is string && data.recordedBy.size() <= 120;
    }

    function isValidClassPlan(data, userId) {
      return data.keys().hasAll(['ownerUid', 'week', 'title', 'targetDate', 'status', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'week', 'title', 'targetDate', 'content', 'status', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.week is string && data.week.size() <= 40 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.targetDate is string && data.targetDate.size() <= 30 &&
        (!('content' in data) || (data.content is string && data.content.size() <= 2000)) &&
        data.status in ['Đang thực hiện', 'Hoàn thành'] &&
        data.createdAtMs is number;
    }

    function isValidYouthActivity(data, userId) {
      return data.keys().hasAll(['ownerUid', 'title', 'date', 'participantCount', 'status', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'title', 'date', 'participantCount', 'description', 'status', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.date is string && data.date.size() <= 30 &&
        data.participantCount is number &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.status is string && data.status.size() <= 50 &&
        data.createdAtMs is number;
    }

    function isValidSubjectScore(data, userId) {
      return data.keys().hasAll(['ownerUid', 'code', 'fullName', 'team', 'subject', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'code', 'fullName', 'team', 'subject', 'tx1', 'tx2', 'gk', 'ck', 'avg', 'note', 'updatedBy', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.code is string && data.code.size() <= 40 &&
        data.fullName is string && data.fullName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        data.subject is string && data.subject.size() <= 100 &&
        (!('tx1' in data) || data.tx1 == null || data.tx1 is number) &&
        (!('tx2' in data) || data.tx2 == null || data.tx2 is number) &&
        (!('gk' in data) || data.gk == null || data.gk is number) &&
        (!('ck' in data) || data.ck == null || data.ck is number) &&
        (!('avg' in data) || data.avg == null || data.avg is number) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.updatedBy is string && data.updatedBy.size() <= 120;
    }

    function isValidVneduImportLog(data, userId) {
      return data.keys().hasAll(['ownerUid', 'subject', 'studentCount', 'importedBy', 'importedAtMs', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'subject', 'studentCount', 'importedBy', 'importedAtMs', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.createdAt is timestamp &&
        data.subject is string && data.subject.size() <= 100 &&
        data.studentCount is number &&
        data.importedBy is string && data.importedBy.size() <= 150 &&
        data.importedAtMs is number;
    }

    function isValidGrade12Profile(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentCode', 'studentName', 'examBlock', 'readiness', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentCode', 'studentName', 'examBlock', 'targetUniversity', 'targetMajor', 'mockScore1', 'mockScore2', 'readiness', 'teacherNote', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.studentCode is string && data.studentCode.size() <= 40 &&
        data.studentName is string && data.studentName.size() <= 150 &&
        data.examBlock is string && data.examBlock.size() <= 100 &&
        (!('targetUniversity' in data) || (data.targetUniversity is string && data.targetUniversity.size() <= 200)) &&
        (!('targetMajor' in data) || (data.targetMajor is string && data.targetMajor.size() <= 200)) &&
        (!('mockScore1' in data) || (data.mockScore1 is string && data.mockScore1.size() <= 30)) &&
        (!('mockScore2' in data) || (data.mockScore2 is string && data.mockScore2.size() <= 30)) &&
        data.readiness is string && data.readiness.size() <= 80 &&
        (!('teacherNote' in data) || (data.teacherNote is string && data.teacherNote.size() <= 1000));
    }

    function isValidEmulationStandards(data, userId) {
      return data.keys().hasAll(['ownerUid', 'gradeA', 'gradeB', 'gradeC', 'severeSemesterFail', 'semesterRules', 'teamBonusRule', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'gradeA', 'gradeB', 'gradeC', 'severeSemesterFail', 'semesterRules', 'teamBonusRule', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.gradeA is list && data.gradeA.size() <= 50 && (data.gradeA.size() == 0 || data.gradeA[0] is map) &&
        data.gradeB is list && data.gradeB.size() <= 100 && (data.gradeB.size() == 0 || data.gradeB[0] is map) &&
        data.gradeC is list && data.gradeC.size() <= 50 && (data.gradeC.size() == 0 || data.gradeC[0] is map) &&
        data.severeSemesterFail is list && data.severeSemesterFail.size() <= 50 && (data.severeSemesterFail.size() == 0 || data.severeSemesterFail[0] is map) &&
        data.semesterRules is map &&
        data.teamBonusRule is map;
    }

    function isValidEmulationWeekSnapshot(data, userId) {
      return data.keys().hasAll(['ownerUid', 'weekNumber', 'weekLabel', 'monthLabel', 'semesterLabel', 'totalLockedStudents', 'records', 'teamStats', 'lockedBy', 'lockedAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'weekNumber', 'weekLabel', 'monthLabel', 'semesterLabel', 'totalLockedStudents', 'records', 'teamStats', 'lockedBy', 'lockedAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 52 &&
        data.weekLabel is string && data.weekLabel.size() <= 40 &&
        data.monthLabel is string && data.monthLabel.size() <= 40 &&
        data.semesterLabel is string && data.semesterLabel.size() <= 40 &&
        data.totalLockedStudents is number &&
        data.records is map &&
        data.teamStats is list && data.teamStats.size() <= 10 && (data.teamStats.size() == 0 || data.teamStats[0] is map) &&
        data.lockedBy is string && data.lockedBy.size() <= 120 &&
        data.lockedAtMs is number;
    }

    function isValidEmulationWeekDraft(data, userId) {
      return data.keys().hasAll(['ownerUid', 'weekNumber', 'weekLabel', 'drafts', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'weekNumber', 'weekLabel', 'drafts', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 52 &&
        data.weekLabel is string && data.weekLabel.size() <= 40 &&
        data.drafts is map;
    }

    function isValidEmulationAdjustmentLog(data, userId) {
      return data.keys().hasAll(['ownerUid', 'weekLabel', 'studentCode', 'studentName', 'team', 'oldRank', 'newRank', 'reason', 'adjustedBy', 'timestampMs', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'weekLabel', 'studentCode', 'studentName', 'team', 'oldRank', 'newRank', 'reason', 'adjustedBy', 'timestampMs', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.createdAt is timestamp &&
        data.weekLabel is string && data.weekLabel.size() <= 40 &&
        data.studentCode is string && data.studentCode.size() <= 40 &&
        data.studentName is string && data.studentName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        data.oldRank in ['A', 'B', 'C'] &&
        data.newRank in ['A', 'B', 'C'] &&
        data.reason is string && data.reason.size() > 0 && data.reason.size() <= 600 &&
        data.adjustedBy is string && data.adjustedBy.size() <= 120 &&
        data.timestampMs is number;
    }

    function isValidSubjectTopic(data, userId) {
      return data.keys().hasAll(['ownerUid', 'subjectKey', 'id', 'semester', 'topicName', 'skillName', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'subjectKey', 'id', 'semester', 'topicName', 'skillName', 'requirement', 'createdBy', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.subjectKey is string && data.subjectKey.size() <= 100 &&
        data.id is string && data.id.size() <= 64 &&
        data.semester is string && data.semester.size() <= 40 &&
        data.topicName is string && data.topicName.size() > 0 && data.topicName.size() <= 200 &&
        data.skillName is string && data.skillName.size() > 0 && data.skillName.size() <= 200 &&
        (!('requirement' in data) || (data.requirement is string && data.requirement.size() <= 500)) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
        data.createdAtMs is number;
    }

    function isValidSubjectQuickCheck(data, userId) {
      return data.keys().hasAll(['ownerUid', 'subjectKey', 'date', 'topicId', 'studentCode', 'studentName', 'team', 'evidenceType', 'level', 'confirmedBy', 'timestampMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'subjectKey', 'date', 'topicId', 'topicName', 'skillName', 'semester', 'studentCode', 'studentName', 'team', 'evidenceType', 'level', 'note', 'confirmedBy', 'timestampMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.subjectKey is string && data.subjectKey.size() <= 100 &&
        data.date is string && data.date.size() <= 30 &&
        data.topicId is string && data.topicId.size() <= 64 &&
        (!('topicName' in data) || (data.topicName is string && data.topicName.size() <= 200)) &&
        (!('skillName' in data) || (data.skillName is string && data.skillName.size() <= 200)) &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 40)) &&
        data.studentCode is string && data.studentCode.size() <= 40 &&
        data.studentName is string && data.studentName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        data.evidenceType is string && data.evidenceType.size() <= 80 &&
        data.level in ['mastered', 'consolidating', 'need_support'] &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.confirmedBy is string && data.confirmedBy.size() <= 120 &&
        data.timestampMs is number;
    }

    function isValidSubjectErrorLog(data, userId) {
      return data.keys().hasAll(['ownerUid', 'subjectKey', 'date', 'topicId', 'studentCode', 'studentName', 'team', 'errorCategory', 'status', 'recordedBy', 'timestampMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'subjectKey', 'date', 'topicId', 'topicName', 'skillName', 'semester', 'studentCode', 'studentName', 'team', 'errorCategory', 'note', 'remedy', 'status', 'fixedAt', 'recordedBy', 'timestampMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.subjectKey is string && data.subjectKey.size() <= 100 &&
        data.date is string && data.date.size() <= 30 &&
        data.topicId is string && data.topicId.size() <= 64 &&
        (!('topicName' in data) || (data.topicName is string && data.topicName.size() <= 200)) &&
        (!('skillName' in data) || (data.skillName is string && data.skillName.size() <= 200)) &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 40)) &&
        data.studentCode is string && data.studentCode.size() <= 40 &&
        data.studentName is string && data.studentName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        data.errorCategory is string && data.errorCategory.size() <= 150 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (!('remedy' in data) || (data.remedy is string && data.remedy.size() <= 500)) &&
        data.status in ['unfixed', 'fixed'] &&
        (!('fixedAt' in data) || data.fixedAt == null || (data.fixedAt is string && data.fixedAt.size() <= 30)) &&
        data.recordedBy is string && data.recordedBy.size() <= 120 &&
        data.timestampMs is number;
    }

    function isValidTeacherAccessRequest(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'requestedSchool', 'requestedClass', 'requestedSubject', 'requestedYear', 'note', 'status', 'approvedBy', 'reviewNote', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
        (!('requestedSchool' in data) || (data.requestedSchool is string && data.requestedSchool.size() <= 200)) &&
        (!('requestedClass' in data) || (data.requestedClass is string && data.requestedClass.size() <= 50)) &&
        (!('requestedSubject' in data) || (data.requestedSubject is string && data.requestedSubject.size() <= 100)) &&
        (!('requestedYear' in data) || (data.requestedYear is string && data.requestedYear.size() <= 50)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.status in ['pending', 'approved', 'rejected', 'revoked'] &&
        (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 200)) &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOfficerRolesList(roles) {
      return roles is list &&
        roles.size() >= 1 &&
        roles.size() <= 2 &&
        roles.hasOnly(['lop_truong', 'to_truong_1', 'to_truong_2', 'to_truong_3', 'to_truong_4', 'thu_quy', 'bi_thu']);
    }

    function isValidOfficerDirectory(data, nicknameId) {
      return data.keys().hasAll(['nickname', 'nicknameId', 'authEmail', 'teacherUid', 'workspaceId', 'active', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nickname', 'nicknameId', 'authEmail', 'teacherUid', 'workspaceId', 'active', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        data.nickname is string && data.nickname.size() >= 3 && data.nickname.size() <= 60 &&
        data.nicknameId is string && data.nicknameId == nicknameId && isValidId(data.nicknameId) &&
        data.authEmail is string && data.authEmail.size() >= 6 && data.authEmail.size() <= 160 &&
        data.teacherUid is string && isValidId(data.teacherUid) &&
        data.workspaceId is string && isValidId(data.workspaceId) &&
        data.active is bool &&
        data.credentialVersion is number && data.credentialVersion >= 1 && data.credentialVersion <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOfficerMembership(data, officerUid) {
      return data.keys().hasAll(['officerUid', 'teacherUid', 'workspaceId', 'schoolName', 'className', 'schoolYear', 'teacherName', 'studentCode', 'studentName', 'nickname', 'nicknameId', 'roles', 'assignedTeam', 'active', 'mustChangePassword', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['officerUid', 'teacherUid', 'workspaceId', 'schoolName', 'className', 'schoolYear', 'teacherName', 'studentCode', 'studentId', 'moetCode', 'studentName', 'nickname', 'nicknameId', 'roles', 'assignedTeam', 'active', 'permissionStatus', 'securityLockReason', 'mustChangePassword', 'allowDirectClassAttendance', 'lastLoginAtMs', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        data.officerUid is string && data.officerUid == officerUid && isValidId(data.officerUid) &&
        data.teacherUid is string && isValidId(data.teacherUid) &&
        data.workspaceId is string && isValidId(data.workspaceId) &&
        data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() <= 200 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 50 &&
        data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 50 &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 120 &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 40)) &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 40)) &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
        data.nickname is string && data.nickname.size() >= 3 && data.nickname.size() <= 60 &&
        data.nicknameId is string && isValidId(data.nicknameId) &&
        isValidOfficerRolesList(data.roles) &&
        data.assignedTeam is number && data.assignedTeam >= 0 && data.assignedTeam <= 4 &&
        data.active is bool &&
        (!('permissionStatus' in data) || data.permissionStatus in ['pending_activation', 'active', 'locked', 'revoked']) &&
        (!('securityLockReason' in data) || (data.securityLockReason is string && data.securityLockReason.size() <= 300)) &&
        data.mustChangePassword is bool &&
        (!('allowDirectClassAttendance' in data) || data.allowDirectClassAttendance is bool) &&
        (!('lastLoginAtMs' in data) || data.lastLoginAtMs is number) &&
        data.credentialVersion is number && data.credentialVersion >= 1 && data.credentialVersion <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOfficerAccount(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentCode', 'studentName', 'team', 'nickname', 'nicknameId', 'officerUid', 'authEmail', 'roles', 'assignedTeam', 'active', 'mustChangePassword', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentCode', 'studentId', 'moetCode', 'studentName', 'team', 'nickname', 'nicknameId', 'officerUid', 'authEmail', 'roles', 'assignedTeam', 'active', 'permissionStatus', 'securityLockReason', 'mustChangePassword', 'allowDirectClassAttendance', 'credentialVersion', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 40)) &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 40)) &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        data.nickname is string && data.nickname.size() >= 3 && data.nickname.size() <= 60 &&
        data.nicknameId is string && isValidId(data.nicknameId) &&
        data.officerUid is string && isValidId(data.officerUid) &&
        data.authEmail is string && data.authEmail.size() >= 6 && data.authEmail.size() <= 160 &&
        isValidOfficerRolesList(data.roles) &&
        data.assignedTeam is number && data.assignedTeam >= 0 && data.assignedTeam <= 4 &&
        data.active is bool &&
        (!('permissionStatus' in data) || data.permissionStatus in ['pending_activation', 'active', 'locked', 'revoked']) &&
        (!('securityLockReason' in data) || (data.securityLockReason is string && data.securityLockReason.size() <= 300)) &&
        data.mustChangePassword is bool &&
        (!('allowDirectClassAttendance' in data) || data.allowDirectClassAttendance is bool) &&
        data.credentialVersion is number && data.credentialVersion >= 1 && data.credentialVersion <= 100;
    }

    function isValidRoleAssignment(data, userId, roleId) {
      return data.keys().hasAll(['ownerUid', 'roleId', 'studentId', 'studentCode', 'studentName', 'team', 'status', 'confirmedByEmail', 'confirmedAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'roleId', 'studentId', 'studentCode', 'moetCode', 'studentName', 'team', 'officerUid', 'nickname', 'status', 'teamMismatchAcknowledged', 'confirmedByEmail', 'confirmedAtMs', 'createdAt', 'updatedAt']) &&
        hasValidOwnerAndTimestamps(data, userId) &&
        data.roleId == roleId &&
        data.roleId in ['lop_truong', 'to_truong_1', 'to_truong_2', 'to_truong_3', 'to_truong_4', 'thu_quy', 'bi_thu'] &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 40 &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 40)) &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
        data.team is number && data.team >= 1 && data.team <= 4 &&
        (!('officerUid' in data) || (data.officerUid is string && data.officerUid.size() <= 128)) &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 60)) &&
        data.status in ['assigned_no_account', 'has_account_pending_activation', 'active', 'locked', 'revoked'] &&
        (!('teamMismatchAcknowledged' in data) || data.teamMismatchAcknowledged is bool) &&
        data.confirmedByEmail is string && data.confirmedByEmail.size() > 0 && data.confirmedByEmail.size() <= 200 &&
        data.confirmedAtMs is number;
    }

    function isValidRoleAssignmentHistory(data, userId) {
      return data.keys().hasAll(['ownerUid', 'roleId', 'previousStudentId', 'previousStudentName', 'newStudentId', 'newStudentName', 'reason', 'changedByEmail', 'changedAtMs', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'roleId', 'previousStudentId', 'previousStudentName', 'newStudentId', 'newStudentName', 'reason', 'changedByEmail', 'changedAtMs', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.roleId in ['lop_truong', 'to_truong_1', 'to_truong_2', 'to_truong_3', 'to_truong_4', 'thu_quy', 'bi_thu'] &&
        data.previousStudentId is string && data.previousStudentId.size() <= 40 &&
        data.previousStudentName is string && data.previousStudentName.size() <= 150 &&
        data.newStudentId is string && data.newStudentId.size() <= 40 &&
        data.newStudentName is string && data.newStudentName.size() <= 150 &&
        data.reason is string && data.reason.size() > 0 && data.reason.size() <= 400 &&
        data.changedByEmail is string && data.changedByEmail.size() > 0 && data.changedByEmail.size() <= 200 &&
        data.changedAtMs is number &&
        data.createdAt is timestamp;
    }

    function isValidPermissionAuditLog(data, userId) {
      return data.keys().hasAll(['ownerUid', 'action', 'nickname', 'studentCode', 'studentName', 'details', 'actorEmail', 'timestampMs', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'action', 'nickname', 'studentCode', 'studentName', 'details', 'actorEmail', 'timestampMs', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 80 &&
        data.nickname is string && data.nickname.size() <= 60 &&
        data.studentCode is string && data.studentCode.size() <= 40 &&
        data.studentName is string && data.studentName.size() <= 150 &&
        data.details is string && data.details.size() <= 600 &&
        data.actorEmail is string && data.actorEmail.size() <= 200 &&
        data.timestampMs is number &&
        data.createdAt is timestamp;
    }

    function isValidPedagogicalObservation(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentId', 'studentCode', 'semester', 'officialConduct', 'officialAcademic', 'incidentStatus', 'sourceLabel', 'confirmedByEmail', 'confirmedAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentId', 'studentCode', 'moetCode', 'semester', 'officialConduct', 'officialAcademic', 'verifiedStrengths', 'verifiedImprovements', 'verifiedAchievements', 'verifiedIncidentNote', 'incidentStatus', 'sourceLabel', 'confirmedByEmail', 'confirmedAtMs', 'createdAt', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 60 &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 60)) &&
        data.semester in ['Học kỳ I', 'Học kỳ II', 'Cả năm'] &&
        data.officialConduct in ['', 'Tốt', 'Khá', 'Đạt', 'Chưa đạt'] &&
        data.officialAcademic in ['', 'Tốt', 'Khá', 'Đạt', 'Chưa đạt'] &&
        (!('verifiedStrengths' in data) || (data.verifiedStrengths is string && data.verifiedStrengths.size() <= 1200)) &&
        (!('verifiedImprovements' in data) || (data.verifiedImprovements is string && data.verifiedImprovements.size() <= 1200)) &&
        (!('verifiedAchievements' in data) || (data.verifiedAchievements is string && data.verifiedAchievements.size() <= 1000)) &&
        (!('verifiedIncidentNote' in data) || (data.verifiedIncidentNote is string && data.verifiedIncidentNote.size() <= 1200)) &&
        data.incidentStatus in ['none', 'verified', 'pending_verification'] &&
        data.sourceLabel is string && data.sourceLabel.size() > 0 && data.sourceLabel.size() <= 200 &&
        data.confirmedByEmail is string && data.confirmedByEmail.size() > 0 && data.confirmedByEmail.size() <= 200 &&
        data.confirmedAtMs is number &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReportCardComment(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentId', 'studentCode', 'studentName', 'semester', 'schoolYear', 'lengthMode', 'currentDraft', 'teacherEdited', 'status', 'versions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentId', 'studentCode', 'moetCode', 'studentName', 'rosterOrder', 'semester', 'schoolYear', 'lengthMode', 'schoolTemplate', 'maxChars', 'currentDraft', 'teacherEdited', 'status', 'approvedByEmail', 'approvedAtMs', 'versions', 'createdAt', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 60 &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 60)) &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
        (!('rosterOrder' in data) || (data.rosterOrder is number && data.rosterOrder >= 0 && data.rosterOrder <= 1000)) &&
        data.semester in ['Học kỳ I', 'Học kỳ II', 'Cả năm'] &&
        data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 40 &&
        data.lengthMode in ['short', 'standard', 'detailed'] &&
        (!('schoolTemplate' in data) || (data.schoolTemplate is string && data.schoolTemplate.size() <= 400)) &&
        (!('maxChars' in data) || (data.maxChars is number && data.maxChars >= 0 && data.maxChars <= 2000)) &&
        data.currentDraft is string && data.currentDraft.size() <= 2000 &&
        data.teacherEdited is bool &&
        data.status in ['draft', 'approved_locked'] &&
        (!('approvedByEmail' in data) || (data.approvedByEmail is string && data.approvedByEmail.size() <= 200)) &&
        (!('approvedAtMs' in data) || data.approvedAtMs is number) &&
        data.versions is list && data.versions.size() <= 15 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidParentMessage(data, userId) {
      return data.keys().hasAll(['ownerUid', 'studentId', 'studentCode', 'studentName', 'semester', 'purpose', 'salutation', 'tone', 'incidentStatus', 'currentDraft', 'teacherEdited', 'status', 'versions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'studentId', 'studentCode', 'moetCode', 'studentName', 'recipientName', 'semester', 'purpose', 'salutation', 'tone', 'incidentStatus', 'currentDraft', 'teacherEdited', 'status', 'approvedByEmail', 'approvedAtMs', 'versions', 'createdAt', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 60 &&
        data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 40 &&
        (!('moetCode' in data) || (data.moetCode is string && data.moetCode.size() <= 60)) &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
        (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 150)) &&
        data.semester in ['Học kỳ I', 'Học kỳ II', 'Cả năm'] &&
        data.purpose in ['khen_ngoi_dong_vien', 'thong_bao_tien_bo', 'nhac_nho_chuyen_can', 'nhac_nho_ne_nep', 'trao_doi_hoc_tap_giam', 'phoi_hop_su_viec_da_xac_minh', 'xac_minh_thong_tin_chua_xac_nhan', 'thong_bao_ke_hoach_hop_ph', 'dinh_huong_thi_tot_nghiep_12', 'dong_vien_tam_ly_hoan_canh'] &&
        data.salutation is string && data.salutation.size() > 0 && data.salutation.size() <= 180 &&
        data.tone in ['trang_trong', 'gan_gui', 'nhe_nhang', 'phoi_hop'] &&
        data.incidentStatus in ['none', 'verified', 'pending_verification'] &&
        data.currentDraft is string && data.currentDraft.size() <= 3000 &&
        data.teacherEdited is bool &&
        data.status in ['draft', 'approved_ready'] &&
        (!('approvedByEmail' in data) || (data.approvedByEmail is string && data.approvedByEmail.size() <= 200)) &&
        (!('approvedAtMs' in data) || data.approvedAtMs is number) &&
        data.versions is list && data.versions.size() <= 15 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ========================================================================
    // COLLECTION MATCH BLOCKS
    // ========================================================================
    match /officer_directory/{nicknameId} {
      allow get: if isValidId(nicknameId);
      allow list: if false;
      allow create: if isValidId(nicknameId) && isApprovedTeacher(request.auth.uid) &&
        isValidOfficerDirectory(incoming(), nicknameId) &&
        incoming().teacherUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(nicknameId) && (isApprovedTeacher(existing().teacherUid) || isAdmin()) &&
        isValidOfficerDirectory(incoming(), nicknameId) &&
        incoming().teacherUid == existing().teacherUid &&
        incoming().nicknameId == existing().nicknameId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['authEmail', 'active', 'credentialVersion', 'updatedAt']);
      allow delete: if isValidId(nicknameId) && (isApprovedTeacher(existing().teacherUid) || isAdmin());
    }

    match /officer_memberships/{officerUid} {
      allow get: if isValidId(officerUid) && (
        (isSignedIn() && request.auth.uid == officerUid) ||
        (resource != null && isApprovedTeacher(resource.data.teacherUid)) ||
        isAdmin()
      );
      allow list: if false;
      allow create: if isValidId(officerUid) && isApprovedTeacher(request.auth.uid) &&
        isValidOfficerMembership(incoming(), officerUid) &&
        incoming().teacherUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(officerUid) &&
        isValidOfficerMembership(incoming(), officerUid) &&
        incoming().officerUid == existing().officerUid &&
        incoming().teacherUid == existing().teacherUid &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().studentCode == existing().studentCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            (isApprovedTeacher(existing().teacherUid) || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['studentId', 'moetCode', 'studentName', 'roles', 'assignedTeam', 'active', 'permissionStatus', 'securityLockReason', 'mustChangePassword', 'allowDirectClassAttendance', 'credentialVersion', 'teacherName', 'schoolName', 'className', 'schoolYear', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            request.auth.uid == officerUid &&
            existing().active == true &&
            incoming().mustChangePassword == false &&
            incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            request.auth.uid == officerUid &&
            existing().active == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAtMs', 'updatedAt'])
          )
        );
      allow delete: if isValidId(officerUid) && (isApprovedTeacher(existing().teacherUid) || isAdmin());
    }

    match /teacher_access_requests/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidTeacherAccessRequest(incoming(), userId) &&
        incoming().email == request.auth.token.email &&
        incoming().status == 'pending' &&
        !('approvedBy' in incoming()) &&
        !('reviewNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isAdmin() &&
        isValidTeacherAccessRequest(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'reviewNote', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isApprovedTeacher(userId);
      allow create: if isValidId(userId) && isApprovedTeacher(userId) &&
        isValidUserRoot(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isApprovedTeacher(userId) &&
        isValidUserRoot(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);

      // Kho mã hóa AES-256-GCM lưu Gemini API key cá nhân của riêng giáo viên
      // Cô lập tuyệt đối: chỉ đúng chủ tài khoản đã phê duyệt (không cho giáo viên khác, quản trị viên hay cán bộ lớp truy cập)
      match /ai_key_vault/{vaultId} {
        allow get: if isValidId(userId) && vaultId == 'gemini' && isApprovedTeacher(userId);
